# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
.next/
out/
dist/
build/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.tox/
.pytest_cache/

# Databases — also exclude SQLite WAL + shared-memory sidecars so they
# don't leak into commits when the API has been running mid-write.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Demo uploads — never commit raw .dem files, they're 100MB+ each and
# this repo isn't a demo archive. Also ignore the .rar/.zip the
# auto-importer may have left in transit.
apps/api/storage/uploads/*.dem
apps/api/storage/uploads/*.dem.gz
apps/api/storage/uploads/*.rar
apps/api/storage/uploads/*.zip

# Platform-specific binaries auto-downloaded at runtime — NEVER commit
# the unrar.exe etc., they're fetched per-host on first boot (see
# services.rar_runtime).
apps/api/storage/bin/
apps/api/UnRAR.exe
apps/api/unrar.exe
apps/api/unrar
**/UnRAR.exe

# Local debug / preview scripts (smoke shader iteration prototypes,
# not part of the shipping source).
smoke_preview*.py
smoke_preview*.png

# Environment
.env
.env.local
.env.*.local
!.env.example
!.env.local.example

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Claude Code local config
.claude/

# Claude Code local config
.claude/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts.bak
