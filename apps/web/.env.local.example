# RIFTSCOPE Web — environment

# --------------------------------------------------------------------
# Local development
# --------------------------------------------------------------------
# Backend API base URL (FastAPI). Direct hit to localhost:8000 — no
# proxy needed because both ends share the localhost registrable
# domain so cookies are already first-party.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --------------------------------------------------------------------
# Production (Vercel)
# --------------------------------------------------------------------
# To fix the cross-site cookie problem (Vercel frontend + Railway
# backend = different registrable domains → browsers in 2026 block
# the auth cookie as 3rd-party, so the session dies every tab close),
# we proxy /api/* through Vercel:
#
#   1. Set NEXT_PUBLIC_API_URL=/api  (the frontend calls /api/...)
#   2. Set BACKEND_URL=https://<railway-app>.up.railway.app
#      ↑ SERVER-SIDE env var (no NEXT_PUBLIC_ prefix). next.config.js
#        reads it and rewrites /api/:path* → ${BACKEND_URL}/:path*.
#
# With those two set, the browser sees every API call as same-origin
# (Vercel domain). The Set-Cookie from the backend flows back through
# the rewrite and gets stored as a first-party cookie → 7-day session
# works the way it's supposed to.
