# RIFTSCOPE API environment

# App
ENVIRONMENT=development
APP_VERSION=0.3.0

# Database
# Dev (default): SQLite, no extra deps required
DATABASE_URL=sqlite:///./riftscope.db
# Prod (uncomment after `pip install -r requirements-prod.txt`)
# DATABASE_URL=postgresql+asyncpg://riftscope:riftscope@localhost:5432/riftscope

# CORS — comma-separated list, no spaces
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Upload limits (bytes)
UPLOAD_MAX_BYTES=524288000

# Backend selectors — flip these to enable Phase 3B implementations.
# stub | demoparser2
PARSER_BACKEND=stub
# local | s3
STORAGE_BACKEND=local
# inprocess | celery
QUEUE_BACKEND=inprocess

# Phase 3B — only needed when PARSER/STORAGE/QUEUE backends are switched
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=
S3_BUCKET=riftscope-demos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
