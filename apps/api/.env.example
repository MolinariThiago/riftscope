# RIFTSCOPE API environment

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=development
APP_VERSION=0.3.0

# Database
# Dev (default): SQLite, no extra deps required
DATABASE_URL=sqlite:///./riftscope.db
# Prod: PostgreSQL (uncomment after `pip install -r requirements-prod.txt`)
# DATABASE_URL=postgresql+asyncpg://riftscope:riftscope@localhost:5432/riftscope

# CORS — comma-separated list, no spaces
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Upload limits (bytes) — CS2 GOTV demos typically sit at
# 100–300 MB but long pro / overtime matches can spill past
# 500 MB, and POV-style demos go much higher. 2 GB gives plenty
# of headroom without letting truly malformed uploads through.
UPLOAD_MAX_BYTES=2147483648

# ---------------------------------------------------------------------------
# Security (JWT — change SECRET_KEY in production!)
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-32+-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Steam OpenID + Web API
# ---------------------------------------------------------------------------
# Required to fetch user profile (name, avatar, profile URL, country)
# after Steam OpenID login. Without this the user is created with
# ``steam:{steam_id}`` as the display name and a null avatar.
#
# Get a free key at: https://steamcommunity.com/dev/apikey
# (paste your domain — ``localhost`` works for dev).
STEAM_API_KEY=

# OpenID realm + return_to root. Steam's OpenID server rejects the
# login if these don't match the URL the browser is coming from, so
# bump them when you deploy to prod.
STEAM_REALM=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Pro-match scraping (Liquipedia + HLTV) — proxy + scheduler config
# ---------------------------------------------------------------------------
# If Liquipedia or HLTV starts 429-ing your IP (Cloudflare bot
# protection), route the scraper through a proxy. Supports HTTP,
# HTTPS, and SOCKS5 (= Tor):
#
#   # Tor SOCKS5 proxy (free):
#   #   1. install Tor (https://www.torproject.org/download/)
#   #   2. start the Tor service
#   #   3. uncomment:
#   # LIQUIPEDIA_PROXY=socks5://127.0.0.1:9050
#   # HLTV_PROXY=socks5://127.0.0.1:9050
#
#   # Generic HTTPS proxy (paid residential, e.g. Bright Data):
#   # LIQUIPEDIA_PROXY=http://user:pass@proxy.example.com:8080
#
# ``HTTPS_PROXY`` / ``HTTP_PROXY`` (system-wide) are also honoured as
# fallback.
# LIQUIPEDIA_PROXY=
# HLTV_PROXY=

# Pro-match auto-import scheduler. Defaults are dev-friendly; set
# PRO_SCHEDULER_ENABLED=0 to disable the background loop entirely.
# PRO_SCHEDULER_ENABLED=1
# PRO_SYNC_INTERVAL_SECONDS=900
# PRO_IMPORT_GAP_SECONDS=60
# PRO_MAX_IMPORTS_PER_TICK=5

# Webshare Static Residential proxy for HLTV downloads. Without this,
# Cloudflare in front of HLTV will challenge most cloud egress IPs and
# the auto-import flow grinds to a halt.
# Format: http://USER:PASS@HOST:PORT  (Webshare → Proxy → Endpoint URL)
# HLTV_PROXY_URL=http://USER:PASS@p.webshare.io:80

# Tier filter for the auto-importer. Only matches whose ProMatch.tier
# is in this list get auto-downloaded by the scheduler — admins can still
# trigger a manual import for any tier from the /pro UI. Comma-separated.
# Default: S+,S,A,B (skips C and Unclassified).
# PRO_AUTO_TIERS=S+,S,A,B

# Max concurrent HLTV imports (download + extract + parse). Webshare gives
# one IP and demoparser2 is CPU-heavy, so 2 is a sane ceiling. Bumping this
# without first moving parsing to Celery just gets the proxy rate-limited
# AND starves the API of CPU.
# PRO_IMPORT_CONCURRENCY=2

# Cutoff date for the /pro feed (YYYY-MM-DD UTC). Defaults to today
# at startup. Set to seed older history for debugging.
# PRO_INDEX_FROM=2026-05-23

# ---------------------------------------------------------------------------
# Backend selectors — flip these to enable production implementations.
# ---------------------------------------------------------------------------
# stub | demoparser2
PARSER_BACKEND=demoparser2
# local | s3   (s3 = Cloudflare R2 / AWS S3 / MinIO)
STORAGE_BACKEND=local
# inprocess | celery
QUEUE_BACKEND=inprocess

# ---------------------------------------------------------------------------
# Celery / Redis  (required when QUEUE_BACKEND=celery)
# Windows tip: use Memurai (Redis-compatible) — sudo apt for Linux users.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Object storage  (required when STORAGE_BACKEND=s3)
# ---------------------------------------------------------------------------
#
# Cloudflare R2:
#   1. Create a bucket at https://dash.cloudflare.com/<account>/r2
#   2. Generate an R2 API token (Bucket-scoped, "Object Read & Write")
#   3. Use the values below — the endpoint is shown on the bucket page.
#
#   S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
#   S3_BUCKET=riftscope-demos
#   S3_ACCESS_KEY=<R2 token Access Key ID>
#   S3_SECRET_KEY=<R2 token Secret Access Key>
#   S3_REGION=auto
#
# AWS S3:
#   S3_ENDPOINT=https://s3.<region>.amazonaws.com
#   S3_REGION=us-east-1
#
# MinIO (self-hosted):
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1
S3_ENDPOINT=
S3_BUCKET=riftscope-demos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ---------------------------------------------------------------------------
# Monetization (Stripe) — master switch is MONETIZATION_ENABLED.
# ---------------------------------------------------------------------------
# When false, all paid features are gated off and uploads are unlimited.
MONETIZATION_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_ID=
