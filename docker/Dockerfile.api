# RIFTSCOPE API — Dockerfile
#
# Build with the slim deps (default, fast, no Rust toolchain needed):
#   docker build -t riftscope-api .
#
# Build with the prod deps (PostgreSQL, Redis, Celery, demoparser2, pandas):
#   docker build -t riftscope-api --build-arg EXTRA_REQS=prod .

FROM python:3.12-slim

ARG EXTRA_REQS=slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Build-essentials only needed when installing the production C/Rust extensions
RUN if [ "$EXTRA_REQS" = "prod" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            build-essential curl ca-certificates \
        && rm -rf /var/lib/apt/lists/*; \
    fi

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY requirements-prod.txt .
RUN if [ "$EXTRA_REQS" = "prod" ]; then \
        pip install -r requirements-prod.txt; \
    fi

COPY . .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
