# RIFTSCOPE — root environment template
#
# Copy the relevant blocks into:
#   apps/api/.env         (FastAPI backend)
#   apps/web/.env.local   (Next.js frontend)
#
# For dev on Windows + Python 3.14 you only need apps/web/.env.local;
# the API ships sensible defaults via apps/api/core/settings.py.

# ============================================================
# apps/web/.env.local
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
# apps/api/.env  (all optional in dev — defaults work out of the box)
# ============================================================
ENVIRONMENT=development
# Default DB is SQLite (no driver to install). Switch to Postgres in prod:
# DATABASE_URL=postgresql+asyncpg://riftscope:riftscope@localhost:5432/riftscope
DATABASE_URL=sqlite:///./riftscope.db

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
UPLOAD_MAX_BYTES=524288000

# Phase 3 only
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=
S3_BUCKET=riftscope-demos
